# ─── Client (Next.js) environment variables ───
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it holds live secrets.

# Base URL of the Express API server
NEXT_PUBLIC_API_URL=http://localhost:5000

# imgBB API key for image uploads (https://api.imgbb.com/)
NEXT_PUBLIC_IMGBB_API_KEY=your-imgbb-api-key

# Stripe publishable key (safe to expose client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# ─── Better Auth (runs inside Next.js) ───
# MongoDB connection string used by the Better Auth adapter
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/crowdfundly
# Long random secret shared with the API server for verifying legacy JWTs
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
# Secret used by Better Auth to sign sessions
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# The app's own origin, server-side. In production use your deployed client URL.
BETTER_AUTH_URL=http://localhost:3000
# The app's own origin, browser-side (used by the Better Auth React client).
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth ───
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
